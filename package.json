{
  "name": "@tangle-network/cartograph",
  "version": "0.1.0",
  "description": "Deterministic repo surface + dependency map for any TypeScript package, with an optional DeepWiki narrative augment for public repos.",
  "type": "module",
  "bin": {
    "cartograph": "bin/cartograph.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "self": "node bin/cartograph.mjs --repo . ",
    "test": "node --test 'tests/*.test.mjs'"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": { "optional": false }
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/cartograph.git"
  }
}
